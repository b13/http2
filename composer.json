{
	"name": "b13/http2",
	"type": "typo3-cms-extension",
	"description": "HTTP2 Server Push Support for TYPO3 - Speed up TYPO3 rendering via HTTP/2 Server Push",
	"require": {
		"typo3/cms-core": "^14.3",
		"typo3/cms-frontend": "^14.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.0",
		"friendsofphp/php-cs-fixer": "^3.94",
		"phpstan/phpstan": "^2.1",
		"typo3/testing-framework": "^9.1",
		"typo3/coding-standards": "^0.8.0"
	},
	"homepage": "https://b13.com",
	"license": ["GPL-2.0-or-later"],
	"authors": [{
		"name": "Benni Mack",
		"email": "benni@b13.com",
		"role": "Maintainer"
	}],
	"extra": {
		"typo3/cms": {
			"extension-key": "http2",
			"version": "3.0.0",
			"Package": {
				"providesPackages": {}
			}
		}
	},
	"autoload": {
		"psr-4": {
			"B13\\Http2\\": "Classes"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"B13\\Http2\\Tests\\": "Tests"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	}
}
